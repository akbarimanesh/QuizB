
<div class="page">

    <form class="ChangePassword-form" method="post" asp-action="ChangePassword">

        <img src="~/pic/logo.png" alt="logo">
        <h5>Eghtesad Novin Bank</h5><br>


        <input placeholder="Enter NumberCard" type="text" name="cardNumber" value="" required><br>

        <input placeholder="Enter Old Password" type="password" name="oldPassword" value="" required><br>
        <input placeholder="Enter New Password" type="password" name="newPassword" value="" required><br><br>
        <button type="send" class="changepassword-btn">Send</button>
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success">@ViewBag.SuccessMessage</div>
        }
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
        }
        
       
    </form>
</div>
