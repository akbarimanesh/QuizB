<div class="page">

    <form class="ListTransactions-form" method="post" asp-action="ListTransactions">

        <img src="~/pic/logo.png" alt="logo">
        <h5>Eghtesad Novin Bank</h5><br>


        <input placeholder="Enter NumberCard" type="text" name="cardNumber" value="" required><br><br>


        <button type="send" class="Transactions-btn">Send</button>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success">@ViewBag.SuccessMessage</div>

        }
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
        }


    </form>
</div>
